[Unit]
Description=MyPowerToys Daemon
Documentation=https://github.com/pedrokarim/my-power-toys
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mpt-daemon
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=30

[Install]
WantedBy=graphical-session.target
